# =============================================================================
# VELORA FASHION - ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# =============================================================================
#
# Follow these instructions to connect your production-ready Supabase backend:
#
# 1. Create a Supabase project at https://supabase.com
# 2. In your Supabase dashboard:
#    - Navigate to: Project Settings -> API
#    - Copy "Project URL" into SUPABASE_URL below
#    - Copy "anon public" key into SUPABASE_ANON_KEY below
# 3. In your Supabase SQL Editor:
#    - Open `supabase/schema.sql` from this repository
#    - Run the entire script to create tables, triggers, and Row Level Security policies
# 4. In Supabase Authentication Settings:
#    - Under "URL Configuration":
#      Site URL: https://velora-fashion-page.vercel.app (or http://localhost:3000 for local dev)
#      Redirect URLs:
#        - http://localhost:3000/**
#        - http://127.0.0.1:3000/**
#        - http://localhost:5500/**
#        - https://velora-fashion-page.vercel.app/**
#        - https://*.vercel.app/**
# 5. For Vercel deployment:
#    - Add these environment variables in your Vercel Project Settings -> Environment Variables.
#    - Also configure js/config.js with your public URL and anon key for the static frontend.
# =============================================================================

# Supabase Project URL (Public REST & Auth Endpoint)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (Safe for client-side use with Row Level Security)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Optional: Supabase Service Role Key (Server-side ONLY, e.g. for secure backend API functions)
# NEVER commit or expose this key in client-side code!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder
